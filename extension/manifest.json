{
  "manifest_version": 3,
  "name": "리디 드릴러 — 서재 인핸서",
  "version": "0.1.0",
  "description": "내 리디 서재를 브라우저 세션 그대로 분석해 미보유 신권·안 읽은 책·작가 신작을 리디 페이지 안에 띄워줍니다.",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "*://ridibooks.com/*",
    "*://*.ridibooks.com/*",
    "http://localhost:3210/*",
    "http://127.0.0.1:3210/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "리디 드릴러",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://ridibooks.com/library*", "*://ridibooks.com/account/library*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
