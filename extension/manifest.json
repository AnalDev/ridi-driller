{
  "manifest_version": 3,
  "name": "북드릴",
  "version": "0.7.0",
  "description": "RIDI 서재를 분석해 소장·미구매·읽기 상태와 별점을 RIDI 화면에 표시하고, 서재와 스토어 목록을 검색·필터·정렬합니다.",
  "permissions": ["activeTab", "cookies", "scripting", "storage"],
  "host_permissions": ["*://ridibooks.com/*", "*://*.ridibooks.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "북드릴",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/page-index.js", "src/page-view.js", "src/reading-notes.js", "src/store-data.js", "src/search-query.js", "src/onboarding.js"],
      "matches": ["*://ridibooks.com/*", "*://*.ridibooks.com/*"]
    },
    {
      "resources": ["src/store-capture.js", "src/store-library.js"],
      "matches": ["https://*.aladin.co.kr/*", "https://*.yes24.com/*", "https://*.kyobobook.co.kr/*", "https://*.ypbooks.co.kr/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://library.ridibooks.com/*", "https://ridibooks.com/library*"],
      "js": ["src/library-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://library.ridibooks.com/*",
        "https://ridibooks.com/library*",
        "https://ridibooks.com/comics/new-releases*",
        "https://ridibooks.com/books/*"
      ],
      "js": ["src/page-enhancer.js"],
      "css": ["src/page-enhancer.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ridibooks.com/*"],
      "exclude_matches": [
        "https://ridibooks.com/library*",
        "https://ridibooks.com/account/*",
        "https://ridibooks.com/order/*",
        "https://ridibooks.com/payment/*",
        "https://ridibooks.com/books/*/view*",
        "https://ridibooks.com/reading-note/*"
      ],
      "js": ["src/store-enhancer.js"],
      "css": ["src/page-enhancer.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ridibooks.com/reading-note/*"],
      "js": ["src/reading-notes-content.js"],
      "run_at": "document_idle"
    }
  ]
}
