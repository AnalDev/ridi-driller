{
  "manifest_version": 3,
  "name": "리디 드릴러 — 서재 인핸서",
  "version": "0.4.0",
  "description": "RIDI 서재·독서노트와 서점 구매 기록을 로컬 서지로 합치고 RIDI 페이지를 개선합니다.",
  "permissions": ["activeTab", "cookies", "scripting", "storage"],
  "host_permissions": [
    "*://ridibooks.com/*",
    "*://*.ridibooks.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "리디 드릴러",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/page-index.js", "src/reading-notes.js"],
      "matches": ["*://ridibooks.com/*", "*://*.ridibooks.com/*"]
    },
    {
      "resources": ["src/store-capture.js", "src/store-library.js"],
      "matches": [
        "https://*.aladin.co.kr/*",
        "https://*.yes24.com/*",
        "https://*.kyobobook.co.kr/*",
        "https://*.ypbooks.co.kr/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://library.ridibooks.com/*",
        "https://ridibooks.com/library*",
        "https://ridibooks.com/comics/new-releases*",
        "https://ridibooks.com/books/*"
      ],
      "js": ["src/page-enhancer.js"],
      "css": ["src/page-enhancer.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ridibooks.com/reading-note/*"],
      "js": ["src/reading-notes-content.js"],
      "run_at": "document_idle"
    }
  ]
}
